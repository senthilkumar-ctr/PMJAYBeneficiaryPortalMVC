@model IEnumerable<PMJAYBeneficiaryPortalMVC.Models.Beneficiary>

@{
    ViewData["Title"] = "Beneficiary Records";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <p class="text-sm font-semibold text-teal-700 mb-1">
                PMJAY BENEFICIARY MANAGEMENT
            </p>
            <h1 class="text-3xl font-bold text-slate-800">
                Beneficiary Records
            </h1>
            <p class="text-slate-500 mt-2">
                Search, review and manage beneficiary registration records.
            </p>
        </div>

        <a asp-controller="Beneficiary"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-teal-800 transition">
            <i class="bi bi-person-plus"></i>
            New Beneficiary
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">Total Records</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                    <i class="bi bi-people text-lg"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                @ViewBag.TotalRecords
            </p>
            <p class="mt-1 text-xs text-slate-400">Registered beneficiaries</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">Verification Pending</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
                    <i class="bi bi-hourglass-split text-lg"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                @ViewBag.PendingRecords
            </p>
            <p class="mt-1 text-xs text-slate-400">Awaiting officer review</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">Correction Pending</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-50 text-orange-700">
                    <i class="bi bi-pencil-square text-lg"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                @ViewBag.CorrectionRecords
            </p>
            <p class="mt-1 text-xs text-slate-400">Records requiring updates</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">Approved</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
                    <i class="bi bi-check-circle text-lg"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                @ViewBag.ApprovedRecords
            </p>
            <p class="mt-1 text-xs text-slate-400">Approved beneficiaries</p>
        </div>

    </div>

    <!-- Search and Filter -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

        <div class="mb-5">
            <h2 class="text-lg font-bold text-slate-800">Search Records</h2>
            <p class="text-sm text-slate-500 mt-1">
                Find beneficiaries by name, code, mobile number or district.
            </p>
        </div>

        <form asp-controller="Beneficiary"
              asp-action="Index"
              method="get"
              class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">

            <div class="xl:col-span-2">
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Search
                </label>
                <div class="relative">
                    <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Name, beneficiary code or mobile..."
                           class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm outline-none focus:border-teal-600 focus:bg-white focus:ring-4 focus:ring-teal-100" />
                </div>
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    District
                </label>
                <select name="district"
                        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100">
                    <option value="">All Districts</option>
                    @if (ViewBag.Districts != null)
                    {
                        foreach (var districtName in ViewBag.Districts)
                        {
                            <option value="@districtName"
                                    selected="@(ViewBag.District == districtName)">
                                @districtName
                            </option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Status
                </label>
                <select name="status"
                        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100">
                    <option value="">All Statuses</option>
                    <option value="VERIFICATION_PENDING" selected="@(ViewBag.Status == "VERIFICATION_PENDING")">Verification Pending</option>
                    <option value="UPDATE_PENDING" selected="@(ViewBag.Status == "UPDATE_PENDING")">Correction Pending</option>
                    <option value="VERIFIED" selected="@(ViewBag.Status == "VERIFIED")">Verified</option>
                    <option value="APPROVED" selected="@(ViewBag.Status == "APPROVED")">Approved</option>
                </select>
            </div>

            <div class="md:col-span-2 xl:col-span-4 flex flex-wrap gap-3">
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-teal-700 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800 transition">
                    <i class="bi bi-search"></i>
                    Search Records
                </button>

                <a asp-controller="Beneficiary"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </a>
            </div>

        </form>
    </div>

    <!-- Beneficiary Table -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Beneficiary List</h2>
                <p class="text-sm text-slate-500 mt-1">
                    Records matching your search criteria
                </p>
            </div>

            <span class="inline-flex w-fit items-center rounded-full bg-teal-50 px-3 py-1.5 text-xs font-semibold text-teal-700">
                @ViewBag.TotalRecords records
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50">
                    <tr class="text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                        <th class="px-5 py-4">Beneficiary</th>
                        <th class="px-5 py-4">District</th>
                        <th class="px-5 py-4">Mobile</th>
                        <th class="px-5 py-4">Registration Date</th>
                        <th class="px-5 py-4">Status</th>
                        <th class="px-5 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                "APPROVED" => "bg-emerald-50 text-emerald-700",
                                "VERIFIED" => "bg-blue-50 text-blue-700",
                                "UPDATE_PENDING" => "bg-orange-50 text-orange-700",
                                "VERIFICATION_PENDING" => "bg-amber-50 text-amber-700",
                                _ => "bg-slate-100 text-slate-600"
                            };

                            var statusText = item.Status switch
                            {
                                "APPROVED" => "Approved",
                                "VERIFIED" => "Verified",
                                "UPDATE_PENDING" => "Correction Pending",
                                "VERIFICATION_PENDING" => "Verification Pending",
                                _ => item.Status ?? "Unknown"
                            };

                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 font-bold text-teal-700">
                                            @(string.IsNullOrWhiteSpace(item.BeneficiaryName)
                                                ? "B"
                                                : item.BeneficiaryName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <p class="font-semibold text-slate-800">
                                                @item.BeneficiaryName
                                            </p>
                                            <p class="mt-1 text-xs text-slate-400">
                                                ID: @item.BeneficiaryCode
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @item.District
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @if (!string.IsNullOrWhiteSpace(item.MobileNumber))
                                    {
                                        @item.MobileNumber
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">Not provided</span>
                                    }
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @item.RegistrationDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="px-5 py-4">
                                    <span class="inline-flex whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <td class="px-5 py-4">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           title="View Details"
                                           class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:border-teal-200 hover:bg-teal-50 hover:text-teal-700">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           title="Edit Beneficiary"
                                           class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:border-amber-200 hover:bg-amber-50 hover:text-amber-700">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-5 py-16 text-center">
                                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                                    <i class="bi bi-folder2-open text-2xl"></i>
                                </div>
                                <h3 class="font-semibold text-slate-700">No records found</h3>
                                <p class="mt-1 text-sm text-slate-500">
                                    Try changing your search or filter criteria.
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-100 px-5 py-4">
            <p class="text-sm text-slate-500">
                Page <span class="font-semibold text-slate-700">@ViewBag.CurrentPage</span>
                of <span class="font-semibold text-slate-700">@ViewBag.TotalPages</span>
            </p>

            <div class="flex gap-2">
                @if ((int)(ViewBag.CurrentPage ?? 1) > 1)
                {
                    <a asp-action="Index"
                       asp-route-search="@ViewBag.Search"
                       asp-route-district="@ViewBag.District"
                       asp-route-status="@ViewBag.Status"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">
                        Previous
                    </a>
                }

                @if ((int)(ViewBag.CurrentPage ?? 1) < (int)(ViewBag.TotalPages ?? 1))
                {
                    <a asp-action="Index"
                       asp-route-search="@ViewBag.Search"
                       asp-route-district="@ViewBag.District"
                       asp-route-status="@ViewBag.Status"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       class="rounded-lg border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800">
                        Next
                    </a>
                }
            </div>
        </div>

    </div>

</div>
