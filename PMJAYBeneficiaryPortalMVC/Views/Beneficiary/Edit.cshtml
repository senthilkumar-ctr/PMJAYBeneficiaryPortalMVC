@model PMJAYBeneficiaryPortalMVC.Models.Beneficiary

@{
    ViewData["Title"] = "Edit Beneficiary";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Edit Beneficiary</h2>
            <p class="text-muted mb-0">
                Update beneficiary information
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Beneficiary Information</h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="BeneficiaryCode"
                               class="form-label"></label>
                        <input asp-for="BeneficiaryCode"
                               class="form-control" />
                        <span asp-validation-for="BeneficiaryCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BeneficiaryName"
                               class="form-label"></label>
                        <input asp-for="BeneficiaryName"
                               class="form-control" />
                        <span asp-validation-for="BeneficiaryName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth"
                               class="form-label"></label>
                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DateOfBirth"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender"
                               class="form-label"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MobileNumber"
                               class="form-label"></label>
                        <input asp-for="MobileNumber"
                               class="form-control"
                               maxlength="10" />
                        <span asp-validation-for="MobileNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AadhaarLast4"
                               class="form-label"></label>
                        <input asp-for="AadhaarLast4"
                               class="form-control"
                               maxlength="4" />
                        <span asp-validation-for="AadhaarLast4"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="District"
                               class="form-label"></label>
                        <input asp-for="District"
                               class="form-control" />
                        <span asp-validation-for="District"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FamilyId"
                               class="form-label"></label>
                        <input asp-for="FamilyId"
                               class="form-control" />
                        <span asp-validation-for="FamilyId"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-light border">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>
                        Update Beneficiary
                    </button>
                    </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
