@model PMJAYBeneficiaryPortalMVC.Models.Beneficiary

@{
    ViewData["Title"] = "New Beneficiary Registration";
}

<div class="mx-auto max-w-7xl space-y-6">

    <!-- Page Heading -->
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
            <div class="mb-2 flex items-center gap-2 text-sm text-slate-500">
                <a asp-controller="Home" asp-action="Index"
                   class="hover:text-teal-700">Dashboard</a>
                <i class="bi bi-chevron-right text-xs"></i>
                <a asp-controller="Beneficiary" asp-action="Index"
                   class="hover:text-teal-700">Beneficiaries</a>
                <i class="bi bi-chevron-right text-xs"></i>
                <span class="font-medium text-teal-700">Registration</span>
            </div>

            <h1 class="text-2xl font-bold tracking-tight text-slate-800 sm:text-3xl">
                New Beneficiary Registration
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Enter the beneficiary details carefully and submit for verification.
            </p>
        </div>

        <a asp-action="Index"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
            <i class="bi bi-arrow-left"></i>
            Back to Records
        </a>
    </div>

    <!-- Information Banner -->
    <div class="flex items-start gap-3 rounded-2xl border border-teal-100 bg-teal-50 p-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-700">
            <i class="bi bi-info-circle-fill text-lg"></i>
        </div>

        <div>
            <h3 class="text-sm font-bold text-teal-900">
                Registration Instructions
            </h3>
            <p class="mt-1 text-sm leading-6 text-teal-800">
                Fields marked with an asterisk (*) are mandatory.
                After registration, the record will be sent to the
                Verification Officer for review.
            </p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">

            <!-- Main Form -->
            <div class="space-y-6 xl:col-span-2">

                <!-- Beneficiary Information -->
                <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                    <div class="flex items-center gap-3 border-b border-slate-100 px-6 py-5">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                            <i class="bi bi-person-vcard-fill text-xl"></i>
                        </div>

                        <div>
                            <h2 class="font-bold text-slate-800">
                                Beneficiary Information
                            </h2>
                            <p class="mt-1 text-xs text-slate-500">
                                Basic personal details
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 p-6 md:grid-cols-2">

                        <!-- Beneficiary Code -->
                        <div>
                            <label asp-for="BeneficiaryCode"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Beneficiary ID <span class="text-red-500">*</span>
                            </label>

                            <input asp-for="BeneficiaryCode"
                                   placeholder="Enter beneficiary ID"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="BeneficiaryCode"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- Name -->
                        <div>
                            <label asp-for="BeneficiaryName"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Beneficiary Name <span class="text-red-500">*</span>
                            </label>

                            <input asp-for="BeneficiaryName"
                                   placeholder="Enter full name"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="BeneficiaryName"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- DOB -->
                        <div>
                            <label asp-for="DateOfBirth"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Date of Birth <span class="text-red-500">*</span>
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="DateOfBirth"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- Gender -->
                        <div>
                            <label asp-for="Gender"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Gender <span class="text-red-500">*</span>
                            </label>

                            <select asp-for="Gender"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>

                            <span asp-validation-for="Gender"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                    </div>
                </section>

                <!-- Contact and Family -->
                <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                    <div class="flex items-center gap-3 border-b border-slate-100 px-6 py-5">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
                            <i class="bi bi-telephone-fill text-lg"></i>
                        </div>

                        <div>
                            <h2 class="font-bold text-slate-800">
                                Contact & Family Details
                            </h2>
                            <p class="mt-1 text-xs text-slate-500">
                                Contact information and identification
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 p-6 md:grid-cols-2">

                        <!-- Mobile -->
                        <div>
                            <label asp-for="MobileNumber"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Mobile Number
                            </label>

                            <input asp-for="MobileNumber"
                                   type="tel"
                                   maxlength="10"
                                   placeholder="Enter 10-digit mobile number"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="MobileNumber"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- Aadhaar Last 4 -->
                        <div>
                            <label asp-for="AadhaarLast4"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Aadhaar Last 4 Digits
                            </label>

                            <input asp-for="AadhaarLast4"
                                   maxlength="4"
                                   inputmode="numeric"
                                   placeholder="Enter last 4 digits only"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="AadhaarLast4"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- District -->
                        <div>
                            <label asp-for="District"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                District <span class="text-red-500">*</span>
                            </label>

                            <input asp-for="District"
                                   placeholder="Enter district"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="District"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                        <!-- Family ID -->
                        <div>
                            <label asp-for="FamilyId"
                                   class="mb-2 block text-sm font-semibold text-slate-700">
                                Family ID
                            </label>

                            <input asp-for="FamilyId"
                                   placeholder="Enter family ID"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/10" />

                            <span asp-validation-for="FamilyId"
                                  class="mt-1 block text-xs text-red-600"></span>
                        </div>

                    </div>
                </section>

                <!-- Form Actions -->
                <div class="flex flex-col-reverse justify-end gap-3 sm:flex-row">

                    <a asp-action="Index"
                       class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                        Cancel
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-7 py-3 text-sm font-bold text-white shadow-lg shadow-teal-700/20 transition hover:bg-teal-800 focus:outline-none focus:ring-4 focus:ring-teal-700/20">
                        <i class="bi bi-check-circle-fill"></i>
                        Register Beneficiary
                    </button>

                </div>

            </div>

            <!-- Right Information Panel -->
            <aside class="space-y-6">

                <!-- Workflow Card -->
                <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                    <div class="border-b border-slate-100 px-5 py-4">
                        <h2 class="font-bold text-slate-800">
                            Registration Workflow
                        </h2>
                        <p class="mt-1 text-xs text-slate-500">
                            What happens after submission?
                        </p>
                    </div>

                    <div class="space-y-5 p-5">

                        <div class="flex gap-3">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-teal-100 text-sm font-bold text-teal-700">
                                1
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-slate-800">
                                    Registration
                                </h3>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    Beneficiary details are entered and submitted.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-sm font-bold text-amber-700">
                                2
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-slate-800">
                                    Verification
                                </h3>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    Verification Officer checks the submitted details.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700">
                                3
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-slate-800">
                                    Approval
                                </h3>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    Verified records proceed for Admin approval.
                                </p>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Privacy Card -->
                <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5">

                    <div class="flex items-center gap-2 text-amber-800">
                        <i class="bi bi-shield-lock-fill text-lg"></i>
                        <h2 class="text-sm font-bold">
                            Data Privacy
                        </h2>
                    </div>

                    <ul class="mt-3 space-y-2 text-xs leading-5 text-amber-900">
                        <li class="flex gap-2">
                            <i class="bi bi-check2 mt-0.5"></i>
                            Enter accurate beneficiary details.
                        </li>
                        <li class="flex gap-2">
                            <i class="bi bi-check2 mt-0.5"></i>
                            Store only Aadhaar last four digits.
                        </li>
                        <li class="flex gap-2">
                            <i class="bi bi-check2 mt-0.5"></i>
                            Verify information before submission.
                        </li>
                    </ul>

                </section>

            </aside>

        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
