@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-8">

    <!-- Welcome Banner -->
    <section class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-teal-800 via-teal-700 to-emerald-600 p-6 text-white shadow-xl sm:p-8">

        <div class="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-center">

            <div>
                <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold backdrop-blur">
                    <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                    PMJAY Management System
                </div>

                <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
                    Welcome to Beneficiary Portal
                </h1>

                <p class="mt-3 max-w-xl text-sm leading-6 text-teal-50 sm:text-base">
                    Manage beneficiary registrations, verification, corrections
                    and approval activities from one secure dashboard.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                @if (User.IsInRole("Admin") || User.IsInRole("DataEntry"))
                {
                    <a asp-controller="Beneficiary"
                       asp-action="Create"
                       class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-teal-800 shadow-lg transition hover:bg-teal-50">
                        <i class="bi bi-person-plus-fill"></i>
                        New Registration
                    </a>
                }

                <a asp-controller="Beneficiary"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/20">
                    <i class="bi bi-people-fill"></i>
                    View Records
                </a>
            </div>

        </div>

        <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-white/10"></div>
        <div class="absolute -bottom-32 right-40 h-64 w-64 rounded-full bg-emerald-300/10"></div>

    </section>

    <!-- Dashboard Summary -->
    <section>
        <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
            <div>
                <h2 class="text-lg font-bold text-slate-800">
                    Beneficiary Overview
                </h2>
                <p class="mt-1 text-sm text-slate-500">
                    Current registration and workflow summary
                </p>
            </div>

            <div class="inline-flex items-center gap-2 text-xs font-medium text-slate-500">
                <i class="bi bi-calendar3"></i>
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

            <!-- Total -->
            <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Total Beneficiaries
                        </p>
                        <h3 class="mt-3 text-3xl font-bold tracking-tight text-slate-800">
                            0
                        </h3>
                    </div>

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                        <i class="bi bi-people-fill text-xl"></i>
                    </div>
                </div>

                <div class="mt-5 border-t border-slate-100 pt-4">
                    <span class="text-xs font-medium text-slate-500">
                        Registered in portal
                    </span>
                </div>
            </div>

            <!-- Pending -->
            <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Verification Pending
                        </p>
                        <h3 class="mt-3 text-3xl font-bold tracking-tight text-amber-600">
                            0
                        </h3>
                    </div>

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <i class="bi bi-hourglass-split text-xl"></i>
                    </div>
                </div>

                <div class="mt-5 border-t border-slate-100 pt-4">
                    <span class="text-xs font-medium text-slate-500">
                        Awaiting verification
                    </span>
                </div>
            </div>

            <!-- Verified -->
            <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Verified
                        </p>
                        <h3 class="mt-3 text-3xl font-bold tracking-tight text-teal-700">
                            0
                        </h3>
                    </div>

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                        <i class="bi bi-check-circle-fill text-xl"></i>
                    </div>
                </div>

                <div class="mt-5 border-t border-slate-100 pt-4">
                    <span class="text-xs font-medium text-slate-500">
                        Verified by officer
                    </span>
                </div>
            </div>

            <!-- Approved -->
            <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Approved
                        </p>
                        <h3 class="mt-3 text-3xl font-bold tracking-tight text-emerald-700">
                            0
                        </h3>
                    </div>

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
                        <i class="bi bi-patch-check-fill text-xl"></i>
                    </div>
                </div>

                <div class="mt-5 border-t border-slate-100 pt-4">
                    <span class="text-xs font-medium text-slate-500">
                        Final approved records
                    </span>
                </div>
            </div>

        </div>
    </section>

    <!-- Quick Actions -->
    <section>
        <div class="mb-5">
            <h2 class="text-lg font-bold text-slate-800">
                Quick Actions
            </h2>
            <p class="mt-1 text-sm text-slate-500">
                Access your daily activities
            </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">

            @if (User.IsInRole("Admin") || User.IsInRole("DataEntry"))
            {
                <a asp-controller="Beneficiary"
                   asp-action="Create"
                   class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-teal-300 hover:shadow-md">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                        <i class="bi bi-person-plus-fill text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800">Register Beneficiary</h3>
                        <p class="mt-1 text-xs text-slate-500">Create a new beneficiary record</p>
                    </div>
                    <i class="bi bi-arrow-up-right ml-auto text-slate-400"></i>
                </a>
            }

            @if (User.IsInRole("Verification") || User.IsInRole("Admin"))
            {
                <a asp-controller="Verification"
                   asp-action="Index"
                   class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-amber-300 hover:shadow-md">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
                        <i class="bi bi-clipboard-check-fill text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800">Verify Records</h3>
                        <p class="mt-1 text-xs text-slate-500">Review pending registrations</p>
                    </div>
                    <i class="bi bi-arrow-up-right ml-auto text-slate-400"></i>
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Staff"
                   asp-action="Index"
                   class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
                        <i class="bi bi-person-gear text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800">Manage Staff</h3>
                        <p class="mt-1 text-xs text-slate-500">Manage staff accounts and roles</p>
                    </div>
                    <i class="bi bi-arrow-up-right ml-auto text-slate-400"></i>
                </a>
            }

        </div>
    </section>

    <!-- Information Panel -->
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
                <i class="bi bi-shield-lock-fill text-lg"></i>
            </div>

            <div>
                <h2 class="font-bold text-slate-800">
                    Secure Beneficiary Management
                </h2>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500">
                    Beneficiary registration and verification activities are
                    available according to your assigned staff role.
                    Please ensure that all details are reviewed carefully
                    before submitting or approving records.
                </p>
            </div>
        </div>
    </section>

</div>
