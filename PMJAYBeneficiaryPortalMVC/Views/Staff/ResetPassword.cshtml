@{
    ViewData["Title"] = "Reset Staff Password";

    var email = ViewBag.Email as string ?? "";
    var userId = ViewBag.UserId as string ?? "";
}

<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6 lg:px-8">

    <div class="mx-auto max-w-5xl">

        <!-- Breadcrumb -->
        <div class="mb-6 flex items-center gap-2 text-sm text-slate-500">
            <a asp-controller="Staff" asp-action="Index"
               class="hover:text-teal-700">Staff Management</a>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="font-semibold text-slate-800">Reset Password</span>
        </div>

        <!-- Header -->
        <div class="mb-7">
            <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-100 text-2xl text-teal-700">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                Reset Staff Password
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Create a new password for the selected staff account.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

            <!-- Password Form -->
            <div class="lg:col-span-2">

                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                    <div class="border-b border-slate-100 px-6 py-5">
                        <h2 class="font-semibold text-slate-900">
                            Account Information
                        </h2>
                        <p class="mt-1 text-sm text-slate-500">
                            Confirm the account and enter the new password.
                        </p>
                    </div>

                    <div class="p-6">

                        @if (ViewBag.Error != null)
                        {
                            <div class="mb-5 flex gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                <span>@ViewBag.Error</span>
                            </div>
                        }

                        <div class="mb-6">
                            <label class="mb-2 block text-sm font-semibold text-slate-700">
                                Staff Email Address
                            </label>

                            <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                                <i class="bi bi-person-circle text-lg text-slate-400"></i>
                                <span class="text-sm font-medium text-slate-700">@email</span>
                            </div>
                        </div>

                        <form asp-controller="Staff"
                              asp-action="ResetPassword"
                              method="post"
                              id="resetPasswordForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@userId" />

                            <div class="mb-5">
                                <label for="newPassword"
                                       class="mb-2 block text-sm font-semibold text-slate-700">
                                    New Password <span class="text-red-500">*</span>
                                </label>

                                <div class="relative">
                                    <input type="password"
                                           id="newPassword"
                                           name="newPassword"
                                           required
                                           minlength="8"
                                           autocomplete="new-password"
                                           placeholder="Enter new password"
                                           class="w-full rounded-xl border border-slate-300 px-4 py-3 pr-12 text-sm outline-none transition focus:border-teal-600 focus:ring-4 focus:ring-teal-100" />

                                    <button type="button"
                                            onclick="togglePassword('newPassword', 'eye1')"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-700">
                                        <i id="eye1" class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <p class="mt-2 text-xs text-slate-500">
                                    Minimum 8 characters. Your Identity password policy may require additional character types.
                                </p>
                            </div>

                            <div class="mb-6">
                                <label for="confirmPassword"
                                       class="mb-2 block text-sm font-semibold text-slate-700">
                                    Confirm New Password <span class="text-red-500">*</span>
                                </label>

                                <div class="relative">
                                    <input type="password"
                                           id="confirmPassword"
                                           required
                                           minlength="8"
                                           autocomplete="new-password"
                                           placeholder="Re-enter new password"
                                           class="w-full rounded-xl border border-slate-300 px-4 py-3 pr-12 text-sm outline-none transition focus:border-teal-600 focus:ring-4 focus:ring-teal-100" />

                                    <button type="button"
                                            onclick="togglePassword('confirmPassword', 'eye2')"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-700">
                                        <i id="eye2" class="bi bi-eye"></i>
                                    </button>
                                </div>

                                <p id="passwordError"
                                   class="mt-2 hidden text-xs font-medium text-red-600">
                                    Passwords do not match.
                                </p>
                            </div>

                            <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">

                                <a asp-controller="Staff"
                                   asp-action="Index"
                                   class="rounded-xl border border-slate-300 px-5 py-3 text-center text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="rounded-xl bg-teal-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-800">
                                    <i class="bi bi-shield-check mr-2"></i>
                                    Reset Password
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            <!-- Information Panel -->
            <div class="space-y-5">

                <div class="rounded-2xl bg-slate-900 p-6 text-white shadow-sm">
                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-xl text-teal-300">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3 class="font-semibold">Security Notice</h3>

                    <p class="mt-2 text-sm leading-6 text-slate-300">
                        Resetting the password changes the login credentials for this staff account.
                        Inform the staff member securely.
                    </p>
                </div>

                <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
                    <div class="flex gap-3">
                        <i class="bi bi-exclamation-triangle-fill mt-0.5 text-amber-600"></i>
                        <div>
                            <h3 class="text-sm font-bold text-amber-900">
                                Important
                            </h3>
                            <p class="mt-2 text-xs leading-5 text-amber-800">
                                Do not share passwords through public messages.
                                Use a secure communication method to provide temporary credentials.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-5">
                    <h3 class="mb-3 text-sm font-bold text-slate-800">
                        Password Checklist
                    </h3>

                    <ul class="space-y-3 text-xs text-slate-600">
                        <li class="flex gap-2">
                            <i class="bi bi-check-circle-fill text-teal-600"></i>
                            Minimum 8 characters
                        </li>
                        <li class="flex gap-2">
                            <i class="bi bi-check-circle-fill text-teal-600"></i>
                            Use a unique password
                        </li>
                        <li class="flex gap-2">
                            <i class="bi bi-check-circle-fill text-teal-600"></i>
                            Avoid easily guessed details
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                input.type = "password";
                icon.className = "bi bi-eye";
            }
        }

        document.getElementById("resetPasswordForm").addEventListener("submit", function(e) {
            const password = document.getElementById("newPassword").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            const error = document.getElementById("passwordError");

            if (password !== confirmPassword) {
                e.preventDefault();
                error.classList.remove("hidden");
                document.getElementById("confirmPassword").focus();
            } else {
                error.classList.add("hidden");
            }
        });
    </script>
}
