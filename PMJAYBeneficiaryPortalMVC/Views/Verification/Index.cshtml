@model IEnumerable<PMJAYBeneficiaryPortalMVC.Models.Beneficiary>

@{
    ViewData["Title"] = "Verification Dashboard";
    var records = Model?.ToList() ?? new List<PMJAYBeneficiaryPortalMVC.Models.Beneficiary>();
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-teal-700">
                PMJAY • Officer Workspace
            </p>
            <h1 class="mt-1 text-3xl font-bold text-slate-800">
                Verification Dashboard
            </h1>
            <p class="mt-2 text-slate-500">
                Review beneficiary registrations and complete verification.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                Pending Review
            </span>
        </div>
    </div>

    <!-- Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">
                    Awaiting Verification
                </p>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
                    <i class="bi bi-clipboard-check text-xl"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                @records.Count
            </p>
            <p class="mt-1 text-xs text-slate-400">
                Records in this queue
            </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">
                    Verification Status
                </p>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                    <i class="bi bi-shield-check text-xl"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                Review
            </p>
            <p class="mt-1 text-xs text-slate-400">
                Check details before confirming
            </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500">
                    Officer Action
                </p>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
                    <i class="bi bi-person-check text-xl"></i>
                </span>
            </div>
            <p class="mt-4 text-3xl font-bold text-slate-800">
                Verify
            </p>
            <p class="mt-1 text-xs text-slate-400">
                Or return for correction
            </p>
        </div>

    </div>

    <!-- Queue -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 px-5 py-5">
            <div>
                <h2 class="text-lg font-bold text-slate-800">
                    Verification Queue
                </h2>
                <p class="mt-1 text-sm text-slate-500">
                    Beneficiaries submitted by data entry staff
                </p>
            </div>

            <span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
                @records.Count pending
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">

                <thead class="bg-slate-50">
                    <tr class="text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                        <th class="px-5 py-4">Beneficiary</th>
                        <th class="px-5 py-4">District</th>
                        <th class="px-5 py-4">Mobile</th>
                        <th class="px-5 py-4">Submitted</th>
                        <th class="px-5 py-4">Status</th>
                        <th class="px-5 py-4 text-right">Review</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">

                    @if (records.Any())
                    {
                        foreach (var item in records)
                        {
                            <tr class="transition hover:bg-slate-50">

                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 font-bold text-teal-700">
                                            @(string.IsNullOrWhiteSpace(item.BeneficiaryName)
                                                ? "B"
                                                : item.BeneficiaryName.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>
                                            <p class="font-semibold text-slate-800">
                                                @item.BeneficiaryName
                                            </p>
                                            <p class="mt-1 text-xs text-slate-400">
                                                @item.BeneficiaryCode
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @item.District
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @(string.IsNullOrWhiteSpace(item.MobileNumber)
                                        ? "Not provided"
                                        : item.MobileNumber)
                                </td>

                                <td class="px-5 py-4 text-sm text-slate-600">
                                    @item.RegistrationDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="px-5 py-4">
                                    <span class="inline-flex whitespace-nowrap rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700">
                                        <i class="bi bi-clock mr-1"></i>
                                        Pending
                                    </span>
                                </td>

                                <td class="px-5 py-4 text-right">
                                    <a asp-controller="Verification"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="inline-flex items-center gap-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800 transition">
                                        Review
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-5 py-16 text-center">
                                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
                                    <i class="bi bi-check2-circle text-2xl"></i>
                                </div>

                                <h3 class="font-semibold text-slate-700">
                                    No pending verification
                                </h3>

                                <p class="mt-1 text-sm text-slate-500">
                                    All submitted records have been reviewed.
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-100 px-5 py-4">
            <p class="text-sm text-slate-500">
                Showing <span class="font-semibold text-slate-700">@records.Count</span>
                pending record(s)
            </p>

            <span class="text-xs text-slate-400">
                PMJAY Beneficiary Portal
            </span>
        </div>

    </div>

</div>
