
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PMJAY Beneficiary Portal</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a'
                        },
                        gold: '#d97706'
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            color: #cbd5e1;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
        }

        .sidebar-link:hover {
            background: rgba(255,255,255,.08);
            color: white;
        }

        .sidebar-link.active {
            background: #0f766e;
            color: white;
        }

        .sidebar-heading {
            padding: 18px 14px 8px;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .page-content {
            min-height: calc(100vh - 72px);
        }

        #sidebarOverlay {
            display: none;
        }

        @@media (max-width: 767px) {
            #sidebar {
                transform: translateX(-100%);
                transition: transform .25s ease;
            }

            #sidebar.open {
                transform: translateX(0);
            }

            #sidebarOverlay.show {
                display: block;
            }
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-800">

    <div class="min-h-screen">

        <!-- Mobile overlay -->
        <div id="sidebarOverlay"
             class="fixed inset-0 z-40 bg-slate-950/50 md:hidden"
             onclick="closeSidebar()"></div>

        <!-- Sidebar -->
        <aside id="sidebar"
               class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col bg-slate-900 text-white">

            <!-- Logo -->
            <div class="flex h-20 items-center gap-3 border-b border-white/10 px-6">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-700 text-xl text-white">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div>
                    <h1 class="text-base font-bold tracking-wide">
                        PMJAY Portal
                    </h1>
                    <p class="text-xs text-slate-400">
                        Beneficiary Management
                    </p>
                </div>            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto px-4 pb-4">

                <div class="sidebar-heading">Main Menu</div>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-grid-1x2-fill text-lg"></i>
                        Dashboard
                    </a>
                    

                 <a asp-controller="DatabaseSearch"
   asp-action="Index"
   class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-teal-50">
    <i class="bi bi-database-search"></i>
    <span>Database Search</span>
</a>

                }

                @if (User.IsInRole("Admin") || User.IsInRole("DataEntry"))
                {
                    <a asp-controller="Beneficiary"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-people-fill text-lg"></i>
                        Beneficiary Records
                    </a>

                    <a asp-controller="Beneficiary"
                       asp-action="Create"
                       class="sidebar-link">
                        <i class="bi bi-person-plus-fill text-lg"></i>
                        New Registration
                    </a>

                    <a asp-controller="Beneficiary"
                       asp-action="Index"
                       asp-route-status="UPDATE_PENDING"
                       class="sidebar-link">
                        <i class="bi bi-pencil-square text-lg"></i>
                        Correction Pending
                    </a>
                }

                @if (User.IsInRole("Verification") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Verification"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-clipboard-check-fill text-lg"></i>
                        Beneficiary Verification
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="sidebar-heading">Management</div>

                    <a asp-controller="Beneficiary"
                       asp-action="Index"
                       asp-route-status="VERIFICATION_PENDING"
                       class="sidebar-link">
                        <i class="bi bi-hourglass-split text-lg"></i>
                        Verification Pending
                    </a>

                    <a asp-controller="Beneficiary"
                       asp-action="Index"
                       asp-route-status="VERIFIED"
                       class="sidebar-link">
                        <i class="bi bi-check2-circle text-lg"></i>
                        Verified Records
                    </a>

                    <a asp-controller="Beneficiary"
                       asp-action="Index"
                       asp-route-status="APPROVED"
                       class="sidebar-link">
                        <i class="bi bi-patch-check-fill text-lg"></i>
                        Approved Records
                    </a>

                    <div class="sidebar-heading">Administration</div>

                    <a asp-controller="Staff"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-person-gear text-lg"></i>
                        Staff User Management
                    </a>

                    <a asp-controller="Staff"
                       asp-action="Create"
                       class="sidebar-link">
                        <i class="bi bi-person-add text-lg"></i>
                        Create Staff Account
                    </a>
                     <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-500/10 hover:text-red-200">

            <i class="bi bi-box-arrow-right text-lg"></i>
            Logout

        </button>
    </form>

                }

            </nav>

            <!-- Sidebar footer -->
            
<!-- Sidebar footer -->
<div class="border-t border-white/10 p-4">

    <div class="mb-3 flex items-center gap-3 rounded-xl bg-white/5 p-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-700 font-bold text-white">
            @(string.IsNullOrWhiteSpace(User.Identity?.Name)
                ? "U"
                : User.Identity.Name.Substring(0, 1).ToUpperInvariant())
        </div>

        <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-white">
                @(User.Identity?.Name ?? "User")
            </p>
            <p class="text-xs text-slate-400">Secure Staff Account</p>
        </div>
    </div>
   

    <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-500/10 hover:text-red-200">

            <i class="bi bi-box-arrow-right text-lg"></i>
            Logout

        </button>
    </form>

</div>

        </aside>

        <!-- Main area -->
        <div class="md:pl-72">

            <!-- Topbar -->
            <header class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-200 bg-white px-4 shadow-sm sm:px-6 lg:px-8">

                <div class="flex items-center gap-4">
                    <button type="button"
                            onclick="toggleSidebar()"
                            class="rounded-lg border border-slate-200 p-2 text-slate-600 hover:bg-slate-100 md:hidden">
                        <i class="bi bi-list text-xl"></i>
                    </button>

                    <div>
                        <h2 class="text-lg font-bold text-slate-800">
                            @ViewData["Title"]
                        </h2>
                        <p class="hidden text-xs text-slate-500 sm:block">
                            Tamil Nadu • PMJAY Beneficiary Services
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="hidden text-right sm:block">
                        <p class="text-sm font-semibold text-slate-700">
                            @(User.Identity?.Name ?? "User")
                        </p>
                        <p class="text-xs text-slate-500">
                            Secure Staff Portal
                        </p>
                          <button type="submit"
                class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-500/10 hover:text-red-200">

            <i class="bi bi-box-arrow-right text-lg"></i>
            Logout

        </button>
                    </div>

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 font-bold text-primary-800">
                        @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                    </div>
                </div>

            </header>

            <!-- Page content -->
            <main class="page-content p-4 sm:p-6 lg:p-8">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-5 flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
                        <i class="bi bi-check-circle-fill text-lg"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
                        <i class="bi bi-exclamation-circle-fill text-lg"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                @RenderBody()

            </main>

            <!-- Footer -->
            <footer class="border-t border-slate-200 bg-white px-6 py-4">
                <div class="flex flex-col justify-between gap-2 text-xs text-slate-500 sm:flex-row">
                    <p>
                        © @DateTime.Now.Year PMJAY Beneficiary Portal
                    </p>
                    <p>
                        Tamil Nadu Health Services
                    </p>
                </div>
            </footer>

        </div>

    </div>

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("sidebarOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("sidebarOverlay").classList.remove("show");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
