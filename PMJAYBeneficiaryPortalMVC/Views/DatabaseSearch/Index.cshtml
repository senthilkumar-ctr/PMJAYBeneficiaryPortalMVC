
@model PMJAYBeneficiaryPortalMVC.Models.DatabaseSearchViewModel

@{
    ViewData["Title"] = "PMJAY Database Search";
}

<div class="min-h-screen bg-slate-50 p-4 md:p-8">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-3">
                <div class="bg-teal-700 text-white p-3 rounded-xl">
                    <i class="bi bi-database-search text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-slate-800">
                        PMJAY Database Search
                    </h1>
                    <p class="text-slate-500 text-sm">
                        Beneficiary cross-database verification system
                    </p>
                </div>
            </div>
        </div>

        <!-- Search Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6">
            <h2 class="font-bold text-lg text-slate-800 mb-1">
                Search Beneficiary
            </h2>

            <p class="text-sm text-slate-500 mb-5">
                Enter Family ID / UFC number to check both databases.
            </p>

            <form asp-action="Index"
                  asp-controller="DatabaseSearch"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="flex flex-col md:flex-row gap-3">
                    <div class="flex-1">
                        <input asp-for="SearchNumber"
                               placeholder="Enter Family ID / UFC number"
                               class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none"
                               required />
                    </div>

                    <button type="submit"
                            class="px-8 py-3 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl transition">
                        <i class="bi bi-search mr-2"></i>
                        Search Database
                    </button>
                </div>
            </form>
        </div>

        @if (Model.HasSearched)
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl mb-6">
                    <i class="bi bi-exclamation-triangle mr-2"></i>
                    @Model.ErrorMessage
                </div>
            }
            else
            {
                <!-- Search Summary -->
                <div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
                    <p class="text-sm text-slate-500">Search Number</p>
                    <h2 class="text-xl font-bold text-slate-800 mt-1">
                        @Model.SearchNumber
                    </h2>
                </div>

                <!-- Summary Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">

                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="text-sm text-slate-500">CMCHIS Records</p>
                                <h2 class="text-3xl font-bold text-blue-700 mt-2">
                                    @Model.FirstDatabaseCount
                                </h2>
                                <p class="text-xs text-slate-400 mt-2">
                                    newcmchisSEP26.dbo.cmchis_data
                                </p>
                            </div>
                            <div class="bg-blue-50 text-blue-700 p-4 rounded-xl">
                                <i class="bi bi-database text-2xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="text-sm text-slate-500">PMJAY Records</p>
                                <h2 class="text-3xl font-bold text-purple-700 mt-2">
                                    @Model.SecondDatabaseCount
                                </h2>
                                <p class="text-xs text-slate-400 mt-2">
                                    newpmjayrationshopadd1.dbo.cmchis_pmjay_secc_full
                                </p>
                            </div>
                            <div class="bg-purple-50 text-purple-700 p-4 rounded-xl">
                                <i class="bi bi-people text-2xl"></i>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- CMCHIS DETAILS -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">

                    <div class="p-5 border-b border-slate-200 flex flex-col md:flex-row justify-between gap-3">
                        <div>
                            <h2 class="font-bold text-lg text-slate-800">
                                <i class="bi bi-database text-blue-700 mr-2"></i>
                                CMCHIS Matching Details
                            </h2>
                            <p class="text-sm text-slate-500 mt-1">
                                Search column: apr_ufc_2026
                            </p>
                        </div>

                        <span class="bg-blue-50 text-blue-700 px-4 py-2 rounded-lg text-sm font-semibold">
                            @Model.CMCHISRecords.Count Records
                        </span>
                    </div>

                    @if (Model.CMCHISRecords.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-500">
                            <i class="bi bi-search text-3xl text-slate-300"></i>
                            <p class="mt-3 font-semibold">No CMCHIS records found</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead class="bg-blue-50 text-slate-700">
                                    <tr>
                                        <th class="px-4 py-4 text-left">S.No</th>
                                        <th class="px-4 py-4 text-left">Member Name</th>
                                        <th class="px-4 py-4 text-left">Tamil Name</th>
                                        <th class="px-4 py-4 text-left">Gender</th>
                                        <th class="px-4 py-4 text-left">Mobile</th>
                                        <th class="px-4 py-4 text-left">Ration Card</th>
                                        <th class="px-4 py-4 text-left">URN</th>
                                        <th class="px-4 py-4 text-left">Address</th>
                                        <th class="px-4 py-4 text-left">Village</th>
                                        <th class="px-4 py-4 text-left">Taluk</th>
                                        <th class="px-4 py-4 text-left">District</th>
                                        <th class="px-4 py-4 text-left">Shop Code</th>
                                    </tr>
                                </thead>

                                <tbody class="divide-y divide-slate-100">
                                    @{
                                        int cmchisCount = 0;
                                    }

                                    @foreach (var item in Model.CMCHISRecords)
                                    {
                                        cmchisCount++;

                                        <tr class="hover:bg-blue-50 transition">
                                            <td class="px-4 py-4">@cmchisCount</td>
                                            <td class="px-4 py-4 font-semibold text-slate-800">
                                                @item.MemberName
                                            </td>
                                            <td class="px-4 py-4">@item.TamilName</td>
                                            <td class="px-4 py-4">@item.Gender</td>
                                            <td class="px-4 py-4">@item.Mobile</td>
                                            <td class="px-4 py-4">@item.RationCard</td>
                                            <td class="px-4 py-4">@item.URN</td>
                                            <td class="px-4 py-4 min-w-48">@item.Address</td>
                                            <td class="px-4 py-4">@item.Village</td>
                                            <td class="px-4 py-4">@item.Taluk</td>
                                            <td class="px-4 py-4">@item.District</td>
                                            <td class="px-4 py-4">@item.RationShopCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- PMJAY DETAILS -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">

                    <div class="p-5 border-b border-slate-200 flex flex-col md:flex-row justify-between gap-3">
                        <div>
                            <h2 class="font-bold text-lg text-slate-800">
                                <i class="bi bi-people text-purple-700 mr-2"></i>
                                PMJAY Matching Details
                            </h2>
                            <p class="text-sm text-slate-500 mt-1">
                                Search column: family_id
                            </p>
                        </div>

                        <span class="bg-purple-50 text-purple-700 px-4 py-2 rounded-lg text-sm font-semibold">
                            @Model.PMJAYRecords.Count Records
                        </span>
                    </div>

                    @if (Model.PMJAYRecords.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-500">
                            <i class="bi bi-search text-3xl text-slate-300"></i>
                            <p class="mt-3 font-semibold">No PMJAY records found</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead class="bg-purple-50 text-slate-700">
                                    <tr>
                                        <th class="px-4 py-4 text-left">S.No</th>
                                        <th class="px-4 py-4 text-left">Beneficiary Name</th>
                                        <th class="px-4 py-4 text-left">Father / Spouse</th>
                                        <th class="px-4 py-4 text-left">Gender</th>
                                        <th class="px-4 py-4 text-left">Mobile</th>
                                        <th class="px-4 py-4 text-left">Family ID</th>
                                        <th class="px-4 py-4 text-left">ENR Number</th>
                                        <th class="px-4 py-4 text-left">Address</th>
                                        <th class="px-4 py-4 text-left">District</th>
                                        <th class="px-4 py-4 text-left">Taluk</th>
                                        <th class="px-4 py-4 text-left">Village</th>
                                        <th class="px-4 py-4 text-left">Ration Shop</th>
                                    </tr>
                                </thead>

                                <tbody class="divide-y divide-slate-100">
                                    @{
                                        int pmjayCount = 0;
                                    }

                                    @foreach (var item in Model.PMJAYRecords)
                                    {
                                        pmjayCount++;

                                        <tr class="hover:bg-purple-50 transition">
                                            <td class="px-4 py-4">@pmjayCount</td>
                                            <td class="px-4 py-4 font-semibold text-slate-800">
                                                @item.BeneficiaryName
                                            </td>
                                            <td class="px-4 py-4">@item.FatherSpouseName</td>
                                            <td class="px-4 py-4">@item.Gender</td>
                                            <td class="px-4 py-4">@item.Mobile</td>
                                            <td class="px-4 py-4 font-semibold text-purple-700">
                                                @item.FamilyId
                                            </td>
                                            <td class="px-4 py-4">@item.ENR</td>
                                            <td class="px-4 py-4 min-w-48">@item.Address</td>
                                            <td class="px-4 py-4">@item.District</td>
                                            <td class="px-4 py-4">@item.Taluk</td>
                                            <td class="px-4 py-4">@item.Village</td>
                                            <td class="px-4 py-4">@item.ShopNumber</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Footer Information -->
                <div class="bg-teal-50 border border-teal-100 rounded-xl p-4 text-sm text-teal-800">
                    <i class="bi bi-info-circle mr-2"></i>
                    CMCHIS and PMJAY records are displayed independently.
                    Counts represent records returned by each database query;
                    they are not combined or cross-joined.
                </div>
            }
        }
    </div>
</div>
